# Development credentials for the local MySQL 8 container. Copy this file to
# .env.development and fill in the values. The file is git-ignored.
#
# On the build host the container is created with:
#   docker run -d --name seo-v01-mysql -p 127.0.0.1:3307:3306 \
#     -e MYSQL_DATABASE=emailsender_v01 -e MYSQL_USERNAME=seo_v01 \
#     -e MYSQL_PASSWORD=<here> -e MYSQL_ROOT_PASSWORD=<here> mysql:8.0
SEO_DB_USERNAME=seo_v01
SEO_DB_PASSWORD=replace-me
SEO_DB_ROOT_PASSWORD=replace-me-too
SEO_DB_NAME=emailsender_v01
